{
  "expo": {
    "name": "私人小说",
    "slug": "apple-novel-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "applenovelapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apaarc.applenovelapp",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.apaarc.applenovelapp"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "./plugins/withSherpaOnnxBackgroundDownloader"
    ],
    "newArchEnabled": true
  }
}
